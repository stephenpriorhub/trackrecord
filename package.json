{
  "name": "trackrecord",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:authz": "node --import tsx --env-file=.env scripts/test-authz.ts",
    "test:all": "npm run typecheck && npm run test:authz && npm run test:positions",
    "db:migrate": "prisma migrate deploy",
    "test:positions": "node --import tsx --env-file=.env scripts/test-positions.ts",
    "seed:demo": "node --import tsx --env-file=.env scripts/seed-demo-portfolio.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
